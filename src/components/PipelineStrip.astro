---
import Icon from './Icon.astro';
import { withBase } from '../utils/paths';

// Mirrors the Jenkinsfile in iiismailtriki/devsecops-deployment-tracker (15 stages on main, grouped).
// Publish/sign/attest run on main only. The last group is deployment config in the repo, not a
// Jenkins stage (the pipeline does not deploy) — drawn dashed.
const phases = [
  { name: 'Secrets', tools: 'Gitleaks' },
  { name: 'Code', tools: 'pytest · Ruff · Bandit · pip-audit' },
  { name: 'IaC + image', tools: 'Hadolint · Helm lint · Trivy config · Trivy image' },
  { name: 'Supply chain', tools: 'Syft SBOM · GHCR digest · Cosign sign + attest' },
  { name: 'Runtime', tools: 'Helm chart · digest-pinned', config: true },
];
---

<a
  href={withBase('/devsecops-case-study/')}
  class="pipeline group block rounded-2xl border border-bg-600 bg-bg-800/80 p-4 transition-colors hover:border-accent-cyan/40 sm:p-5"
  data-track="DevSecOps Case Study Click"
>
  <div class="mb-4 flex flex-wrap items-center justify-between gap-2">
    <p class="font-mono text-xs text-text-muted">
      <span class="text-accent-cyan">$</span> devsecops-deployment-tracker<span class="hidden text-text-dim sm:inline"> / Jenkinsfile</span>
    </p>
    <span class="link-arrow">
      Flagship case study
      <Icon name="arrow-right" size={13} class="transition-transform group-hover:translate-x-0.5" />
    </span>
  </div>

  <ol class="relative grid grid-cols-1 gap-2 sm:grid-cols-5 sm:gap-3">
    <!-- connector (desktop) -->
    <span class="absolute top-[15px] right-[10%] left-[10%] hidden h-px bg-bg-600 sm:block" aria-hidden="true">
      <span class="pulse absolute inset-y-0 left-0 w-full origin-left bg-linear-to-r from-accent-cyan/0 via-accent-cyan to-accent-green/70"></span>
    </span>

    {
      phases.map((phase, i) => (
        <li class="phase relative flex items-center gap-3 sm:flex-col sm:items-center sm:text-center" style={`--i: ${i}`}>
          <span
            class:list={[
              'dot relative z-10 grid h-[30px] w-[30px] shrink-0 place-items-center rounded-full border bg-bg-800',
              phase.config ? 'border-dashed border-text-dim text-text-dim' : 'border-accent-green/50 text-accent-green',
            ]}
          >
            {phase.config ? <span class="font-mono text-[10px]">k8s</span> : <Icon name="check" size={14} />}
          </span>
          <span>
            <span class="block text-sm font-medium text-text-primary">{phase.name}</span>
            <span class="block font-mono text-[11px] leading-snug text-text-muted">{phase.tools}</span>
          </span>
        </li>
      ))
    }
  </ol>
</a>

<style>
  @keyframes pulse-fill {
    from {
      transform: scaleX(0);
    }
  }
  @keyframes dot-pass {
    from {
      opacity: 0.35;
      transform: scale(0.85);
    }
  }
  :global(.js) .pulse {
    animation: pulse-fill 1.6s cubic-bezier(0.4, 0, 0.2, 1) 0.6s both;
  }
  :global(.js) .phase .dot {
    animation: dot-pass 0.4s ease-out both;
    animation-delay: calc(0.6s + var(--i) * 0.32s);
  }
</style>
