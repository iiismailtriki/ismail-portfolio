---
import Icon from './Icon.astro';
import { site } from '../data/site';

const links = [
  { label: 'Email', value: site.email, href: `mailto:${site.email}`, icon: 'mail', track: 'Email Contact Click' },
  { label: 'LinkedIn', value: 'LinkedIn', href: site.linkedin, icon: 'linkedin', external: true, track: 'LinkedIn Click' },
  { label: 'GitHub', value: `github.com/${site.githubHandle}`, href: site.github, icon: 'github', external: true, track: 'GitHub Click' },
] as const;
---

<section id="contact" class="section" aria-labelledby="contact-title">
  <div class="container-page">
    <div class="reveal relative overflow-hidden rounded-3xl border border-bg-600 bg-bg-800 px-6 py-14 text-center sm:px-12 md:py-20">
      <div class="bg-grid pointer-events-none absolute inset-0 opacity-60" aria-hidden="true"></div>
      <div class="relative mx-auto max-w-2xl">
        <p class="section-label justify-center">Contact</p>
        <h2 id="contact-title" class="section-title">
          Hiring for a junior cloud or<br class="hidden sm:block" />
          <span class="text-accent-cyan italic">DevOps role in Germany?</span>
        </h2>
        <p class="mx-auto mt-4 max-w-xl leading-relaxed text-text-muted">
          Open to junior Cloud Engineering, DevOps, Platform Engineering and DevSecOps roles in Germany and
          remote-friendly European teams. Email is the fastest way to reach me; I reply in English or German.
        </p>

        <div class="mt-8 flex flex-wrap justify-center gap-3">
          <a href={`mailto:${site.email}`} class="btn-primary px-7 py-3 text-base" data-track="Email Contact Click">
            <Icon name="mail" size={17} /> Send an email
          </a>
          <a href={site.cv} download class="btn-ghost px-7 py-3 text-base" data-track="CV Download">
            <Icon name="download" size={17} /> CV (English)
          </a>
          <a href={site.cvDe} download class="btn-ghost px-7 py-3 text-base" data-track="CV DE Download" lang="de">
            <Icon name="download" size={17} /> Lebenslauf (Deutsch)
          </a>
        </div>

        <ul class="mt-10 flex flex-wrap justify-center gap-3">
          {
            links.map((link) => (
              <li>
                <a
                  href={link.href}
                  target={'external' in link ? '_blank' : undefined}
                  rel={'external' in link ? 'noopener noreferrer' : undefined}
                  class="group inline-flex items-center gap-2.5 rounded-full border border-bg-600 bg-bg-900/60 px-4 py-2.5 text-sm text-text-primary transition-colors hover:border-accent-cyan/40 hover:text-accent-cyan"
                  data-track={link.track}
                >
                  <Icon name={link.icon} size={16} class="shrink-0 text-accent-cyan" />
                  <span class="sr-only">{link.label}:</span>
                  {link.value}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
