---
import Icon from './Icon.astro';
import { site } from '../data/site';
import { withBase } from '../utils/paths';

const facts = [
  { label: 'Location', value: 'Marburg, Germany' },
  { label: 'Degree', value: 'Engineering degree, Computer Science (ESPRIT, 2026)' },
  { label: 'Studying', value: 'THWS Schweinfurt (IBE), since Oct 2026' },
  { label: 'Certified', value: 'AWS Solutions Architect – Associate' },
  { label: 'Looking for', value: 'Junior Cloud / DevOps / Platform / DevSecOps roles' },
];

// CEFR levels as stated; no percentage bars (they imply a precision that CEFR doesn't have).
const languages = [
  { lang: 'Arabic', level: 'Native' },
  { lang: 'French', level: 'C1' },
  { lang: 'English', level: 'C1 — IELTS 7.0' },
  { lang: 'German', level: 'B1 — telc B1 exam planned Dec 2026' },
];
---

<section id="about" class="section border-t border-bg-600/60 bg-bg-800/40" aria-labelledby="about-title">
  <div class="container-page grid items-start gap-12 md:grid-cols-[1.2fr_1fr] md:gap-16">
    <div class="reveal">
      <p class="section-label">About</p>
      <h2 id="about-title" class="section-title mb-6">
        How I like<br />
        <span class="text-accent-cyan italic">to work.</span>
      </h2>

      <div class="prose-body">
        <p>
          I'm an early-career cloud engineer with an engineering degree in Computer Science from ESPRIT (Tunisia,
          2026, Cloud Engineering specialization), an academic exchange at Philipps-Universität Marburg, and an AWS
          Solutions Architect – Associate certification. I'm based in Marburg.
        </p>
        <p>
          I like infrastructure I can rebuild from code, pipelines that fail loudly when something is unsafe, and
          systems that can be observed when they misbehave. When something breaks I dig into logs and configuration
          until I understand why — and then write it down, so the fix survives the next person, or the next pod
          restart.
        </p>
        <p>
          I'm looking for a junior Cloud, DevOps, Platform or DevSecOps role in Germany or a remote-friendly European
          team, where I can contribute to real infrastructure and keep learning from experienced engineers.
        </p>
      </div>

      <div class="mt-8 flex flex-wrap gap-3">
        <a href={withBase('/#contact')} class="btn-primary">Get in touch <Icon name="arrow-right" size={15} /></a>
        <a href={site.cv} download class="btn-ghost" data-track="CV Download"><Icon name="download" size={15} /> Download CV</a>
      </div>
    </div>

    <div class="reveal space-y-5" style="--reveal-delay: 80ms">
      <div class="card-base">
        <h3 class="mb-4 font-mono text-[11px] tracking-widest text-text-dim uppercase">Quick facts</h3>
        <dl class="space-y-3">
          {
            facts.map((item) => (
              <div class="grid grid-cols-[96px_1fr] gap-3">
                <dt class="pt-0.5 font-mono text-xs text-text-dim">{item.label}</dt>
                <dd class="text-sm text-text-primary">{item.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>

      <div class="card-base">
        <h3 class="mb-4 font-mono text-[11px] tracking-widest text-text-dim uppercase">Languages</h3>
        <dl class="grid grid-cols-2 gap-3">
          {
            languages.map((item) => (
              <div class="rounded-xl border border-bg-600 bg-bg-800 p-3">
                <dt class="text-sm text-text-primary">{item.lang}</dt>
                <dd class="mt-0.5 font-mono text-xs text-text-muted">{item.level}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </div>
</section>
