---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section id="about" class="py-24 max-w-6xl mx-auto px-6">
  <div class="grid md:grid-cols-2 gap-16 items-start">
    <!-- Left: text -->
    <div class="animate-on-scroll">
      <p class="section-label">About</p>
      <h2 class="section-title mb-6">
        Engineering from<br />
        <span class="text-accent-cyan italic">first principles.</span>
      </h2>

      <div class="space-y-4 text-text-muted leading-relaxed">
        <p>
          Final-year Computer Science &amp; Cloud Engineering student at ESPRIT Tunisia,
          currently on academic exchange at Philipps-Universität Marburg.
        </p>
        <p>
          I enjoy building infrastructure from scratch — designing cloud environments,
          automating deployments, and making systems observable and secure. I lean toward
          open-source tooling and infrastructure-as-code. Looking for Werkstudent or
          internship roles in Cloud, DevOps, or Security Engineering in Germany.
        </p>
      </div>

      <div class="mt-8 flex flex-wrap gap-3">
        <a href="#contact" class="btn-primary text-sm">Get in touch</a>
        <a href="mailto:ismail.triki.2020@gmail.com" class="btn-ghost text-sm">
          ismail.triki.2020@gmail.com
        </a>
      </div>
    </div>

    <!-- Right: facts panel -->
    <div class="animate-on-scroll space-y-4" style="animation-delay: 0.15s;">
      <!-- Quick facts -->
      <div class="card-base space-y-4">
        <p class="font-mono text-xs text-text-dim tracking-widest uppercase">Quick facts</p>

        <div class="space-y-3">
          {[
            { label: 'Location', value: 'Marburg, Germany' },
            { label: 'Degree', value: 'Engineering — Cloud & CS (ESPRIT)' },
            { label: 'Exchange', value: 'Philipps-Universität Marburg' },
            { label: 'Focus', value: 'Cloud · DevSecOps · Security Engineering' },
            { label: 'Available for', value: 'Werkstudent / Internship / Junior roles' },
          ].map((item) => (
            <div class="flex items-start gap-3">
              <span class="font-mono text-xs text-text-dim w-24 shrink-0 pt-0.5">{item.label}</span>
              <span class="text-sm text-text-primary">{item.value}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- Languages -->
      <div class="card-base">
        <p class="font-mono text-xs text-text-dim tracking-widest uppercase mb-4">Languages</p>
        <div class="space-y-3">
          {[
            { lang: 'Arabic', level: 'Native', pct: 100 },
            { lang: 'French', level: 'C1', pct: 85 },
            { lang: 'English', level: 'C1 — IELTS 7.0', pct: 85 },
            { lang: 'German', level: 'A2 (in progress)', pct: 20 },
          ].map((item) => (
            <div>
              <div class="flex justify-between text-xs mb-1">
                <span class="text-text-primary">{item.lang}</span>
                <span class="font-mono text-text-dim">{item.level}</span>
              </div>
              <div class="h-1 bg-bg-600 rounded-full overflow-hidden">
                <div
                  class="h-full bg-accent-cyan rounded-full transition-all duration-700"
                  style={`width: ${item.pct}%`}
                ></div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Certifications -->
      <div class="card-base">
        <p class="font-mono text-xs text-text-dim tracking-widest uppercase mb-4">Certifications</p>
        <div class="space-y-4">
          {[
            {
              name: 'AWS Certified Cloud Practitioner',
              issuer: 'Amazon Web Services',
              dot: 'bg-accent-amber',
              href: 'https://www.credly.com/badges/58168a8e-4f53-4ed0-a898-b92fbb761c50/linked_in?t=t4qoma',
              image: `${base}/certifications/aws-cloud-practitioner.png`,
            },
            {
              name: 'Nutanix Certified Professional — Multicloud Infrastructure 6',
              issuer: 'Nutanix',
              dot: 'bg-accent-green',
              href: 'https://www.credly.com/badges/efe60dc4-cab6-4cdc-a6d7-b256674a40b7/linked_in?t=t3x6lz',
              image: `${base}/certifications/nutanix-ncp-mci6.png`,
            },
          ].map((cert) => (
            <a
              href={cert.href}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-start gap-3 group hover:opacity-80 transition-opacity"
            >
              <div class={`w-1.5 h-1.5 rounded-full ${cert.dot} shrink-0 mt-2`}></div>
              <div class="flex-1 flex items-start justify-between gap-3">
                <div>
                  <p class="text-sm text-text-primary group-hover:text-accent-cyan transition-colors leading-snug">{cert.name}</p>
                  <p class="font-mono text-xs text-text-dim mt-0.5">{cert.issuer}</p>
                  <p class="font-mono text-[10px] text-accent-cyan/60 mt-1">View credential →</p>
                </div>
                <img
                  src={cert.image}
                  alt=""
                  class="w-10 h-10 object-contain shrink-0 opacity-85 rounded"
                  onerror="this.style.display='none'"
                />
              </div>
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
