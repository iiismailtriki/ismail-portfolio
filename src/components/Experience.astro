---
const experiences = [
  {
    title: 'Working Student — IT & Cloud Support',
    company: 'ars vivendi Seniorenresidenz Marburg GmbH',
    location: 'Marburg, Germany',
    period: 'Jun 2026 – Present',
    type: 'Working Student',
    description:
      'Current part-time role at a senior-care residence in Marburg. ars vivendi is a senior-care provider, not a technology or cloud company — this role is practical IT and cloud support work alongside continued personal cloud/DevOps project work.',
    highlights: [
      'Support the migration of internal file storage and backup workflows from on-premises servers to AWS S3',
      'Maintain and update the company website, supporting day-to-day digital operations',
      'Assist with network and connectivity troubleshooting across the Marburg location',
    ],
    stack: ['AWS S3', 'IT Support', 'Website Maintenance', 'Network Troubleshooting'],
    accent: 'green',
  },
  {
    title: 'Cloud Engineering Intern — DevSecOps & Security Automation',
    company: 'Flexos Tunisie',
    location: 'Tunisia (Remote/On-site)',
    period: 'Dec 2025 – Jun 2026',
    type: 'Internship / PFE (Thesis)',
    description:
      'Final-year thesis (PFE) internship. Designed and deployed a cloud-native, open-source SOC platform end to end — from architecture planning and tooling decisions to deployment, detection engineering, and documentation.',
    highlights: [
      'Defined system architecture and selected the security toolchain based on threat coverage and integration requirements',
      'Deployed a three-node k3s Kubernetes cluster on Proxmox VE bare-metal hardware; debugged and resolved networking and storage issues',
      'Authored and validated MITRE ATT&CK–mapped detection rules through simulated attack scenarios, including SSH brute-force, privilege escalation, network reconnaissance, and account-discovery techniques',
      'Automated infrastructure and application deployment using Terraform, Ansible, AWX, and GitHub Actions; maintained deployment and configuration documentation',
    ],
    stack: ['Kubernetes', 'Wazuh', 'OpenSearch', 'Suricata', 'TheHive', 'Cortex', 'Terraform', 'Ansible', 'AWX', 'GitHub Actions', 'Proxmox'],
    accent: 'cyan',
  },
  {
