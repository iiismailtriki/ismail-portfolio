---

<section id="experience" class="section border-y border-bg-600/60 bg-bg-800/40" aria-labelledby="experience-title">
  <div class="container-page">
    <div class="reveal mb-12 max-w-2xl">
      <p class="section-label">Experience</p>
      <h2 id="experience-title" class="section-title">
        Where I've worked<br />
        <span class="text-accent-cyan italic">and what I did there.</span>
      </h2>
    </div>

    <ol class="relative space-y-6 before:absolute before:top-2 before:bottom-2 before:left-[7px] before:w-px before:bg-bg-600 md:before:left-[183px]">
      {
        experiences.map((exp, i) => (
          <li class="reveal relative grid gap-3 pl-8 md:grid-cols-[160px_1fr] md:gap-12 md:pl-0" style={`--reveal-delay: ${i * 40}ms`}>
            <span
              class:list={[
                'absolute top-2 left-0 h-[15px] w-[15px] rounded-full border-2 border-bg-800 md:left-[176px]',
                i === 0 ? 'bg-accent-green ring-4 ring-accent-green/15' : 'bg-bg-600',
              ]}
              aria-hidden="true"
            />
            <div class="md:pt-0.5 md:text-right">
              <p class="font-mono text-xs text-text-primary">{exp.period}</p>
              <p class="mt-1 font-mono text-[11px] tracking-wider text-text-dim uppercase">{exp.type}</p>
            </div>
            <article class="card-base card-hover">
              <h3 class="text-lg leading-snug font-semibold text-text-primary">{exp.title}</h3>
              <p class="mt-1 text-sm text-text-muted">
                {exp.company} <span class="text-text-dim">· {exp.location}</span>
              </p>
              <p class="mt-4 text-sm leading-relaxed text-text-muted">{exp.description}</p>
              <ul class="mt-4 space-y-2">
                {exp.highlights.map((h) => (
                  <li class="flex gap-3 text-sm leading-relaxed text-text-muted">
                    <span class="mt-2.5 h-1 w-1 shrink-0 rounded-full bg-accent-cyan" aria-hidden="true" />
                    <span>{h}</span>
                  </li>
                ))}
              </ul>
              <ul class="mt-5 flex flex-wrap gap-1.5">
                {exp.stack.map((t) => <li class="tag">{t}</li>)}
              </ul>
            </article>
          </li>
        ))
      }
    </ol>

    <div class="reveal mt-16">
      <h3 class="mb-5 font-mono text-xs tracking-[0.2em] text-text-dim uppercase">Education</h3>
      <div class="grid gap-5 md:grid-cols-2">
        {
          education.map((edu) => (
            <article class="card-base">
              <p class="font-mono text-xs text-text-dim">{edu.period} · {edu.location}</p>
              <h4 class="mt-2 font-semibold text-text-primary">{edu.degree}</h4>
              <p class="mt-1 text-sm text-text-muted">{edu.school}</p>
              <p class="mt-3 text-sm text-accent-cyan">{edu.note}</p>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>
