---
const experiences = [
  {
    title: 'Cloud Engineering Intern — DevSecOps & Security Automation',
    company: 'Flexos Tunisie',
    location: 'Tunisia (Remote/On-site)',
    period: 'Dec 2025 – Jul 2026',
    type: 'Internship / PFE (Thesis)',
    description:
      'Final-year thesis (PFE) internship. Designed and deployed a cloud-native, open-source SOC platform end to end — from architecture planning and tooling decisions to deployment, detection engineering, and documentation.',
    highlights: [
      'Defined system architecture and selected the security toolchain based on threat coverage and integration requirements',
      'Deployed a three-node k3s Kubernetes cluster on Proxmox VE bare-metal hardware; debugged and resolved networking and storage issues',
      'Authored and validated MITRE ATT&CK–mapped detection rules through simulated attack scenarios, including SSH brute-force, privilege escalation, network reconnaissance, and account-discovery techniques',
      'Managed infrastructure-as-code with Terraform and Ansible; maintained deployment and configuration documentation',
    ],
    stack: ['Kubernetes', 'Wazuh', 'OpenSearch', 'Suricata', 'TheHive', 'Cortex', 'Terraform', 'Ansible', 'Proxmox'],
    accent: 'cyan',
  },
  {
    title: 'Cloud & Security Engineering Intern',
    company: 'Flexos Tunisie',
    location: 'Tunis, Tunisia',
    period: 'Aug 2025 – Oct 2025',
    type: 'Internship',
    description:
      'First internship at Flexos, focused on hands-on cloud operations support — the groundwork ahead of the later thesis project.',
    highlights: [
      'Assisted in deploying and maintaining Linux-based cloud environments for security and monitoring systems',
      'Supported configuration and operation of containerized services using Docker',
      'Contributed to system monitoring pipelines and log management workflows',
      'Participated in infrastructure troubleshooting and environment validation',
    ],
    stack: ['Linux', 'Docker', 'Monitoring', 'Log Management'],
    accent: 'cyan',
  },
  {
    title: 'Innovation Intern — International Program',
    company: 'PVG University / AIESEC',
    location: 'Pune, India',
    period: 'Jun 2025 – Aug 2025',
    type: 'International Internship',
    description:
      'International innovation program at an engineering university in Pune, India, in an intercultural team. Supported DevOps workflows, pipeline monitoring, and technical documentation.',
    highlights: [
      'Supported DevOps-oriented workflows for enterprise data and reporting systems, including pipeline monitoring and validation',
      'Contributed to technical documentation for infrastructure and operational system components',
      'Co-developed Vocallia, a cloud-oriented AI voice automation platform, with an international team — selected Top 10 at OSTX Tunisia 2025',
      'Gained practical exposure to CI/CD tooling and enterprise IT operations',
    ],
    stack: ['DevOps', 'CI/CD', 'Data Pipelines', 'Documentation', 'AI Voice Automation'],
    accent: 'green',
  },
  {
    title: 'Data / Consulting Intern',
    company: 'Devoteam',
    location: 'Ariana, Tunisia',
    period: 'Jun 2024 – Aug 2024',
    type: 'Internship',
    description:
      'Internship at a cloud technology consulting firm. Supported DevOps and data workflows for client-facing reporting systems.',
    highlights: [
      'Supported DevOps-oriented workflows for enterprise data and reporting systems',
      'Assisted in monitoring and validating data processing pipelines and system processes',
      'Contributed to technical documentation of infrastructure and system workflows',
    ],
    stack: ['DevOps', 'Data Workflows', 'Consulting', 'Documentation', 'Monitoring'],
    accent: 'amber',
  },
];

const accentMap: Record<string, { dot: string; line: string; badge: string }> = {
  cyan: { dot: 'bg-accent-cyan', line: 'border-accent-cyan/30', badge: 'bg-accent-cyan/10 text-accent-cyan border-accent-cyan/20' },
  green: { dot: 'bg-accent-green', line: 'border-accent-green/30', badge: 'bg-accent-green/10 text-accent-green border-accent-green/20' },
  amber: { dot: 'bg-accent-amber', line: 'border-accent-amber/30', badge: 'bg-accent-amber/10 text-accent-amber border-accent-amber/20' },
};
---

<section id="experience" class="py-24 bg-bg-800/40">
  <div class="max-w-6xl mx-auto px-6">
    <div class="max-w-xl mb-14 animate-on-scroll">
      <p class="section-label">Experience</p>
      <h2 class="section-title">
        Where I've worked<br />
        <span class="text-accent-cyan italic">and what I built.</span>
      </h2>
    </div>

    <!-- Timeline -->
    <div class="relative">
      <!-- Vertical line -->
      <div class="absolute left-4 md:left-6 top-0 bottom-0 w-px bg-bg-600"></div>

      <div class="space-y-12">
        {experiences.map((exp, i) => {
          const a = accentMap[exp.accent];
          return (
            <div class="relative pl-12 md:pl-16 animate-on-scroll" style={`animation-delay: ${i * 0.1}s`}>
              <!-- Dot -->
              <div class={`absolute left-3 md:left-[19px] top-1.5 w-2.5 h-2.5 rounded-full ${a.dot} ring-4 ring-bg-900`}></div>

              <!-- Card -->
              <div class="card-base card-hover">
                <div class="flex flex-wrap items-start justify-between gap-4 mb-4">
                  <div>
                    <h3 class="font-semibold text-text-primary text-lg">{exp.title}</h3>
                    <p class="text-text-muted text-sm mt-0.5">
                      {exp.company} &mdash; <span class="text-text-dim">{exp.location}</span>
                    </p>
                  </div>
                  <div class="flex flex-col items-end gap-2 shrink-0">
                    <span class="font-mono text-xs text-text-dim">{exp.period}</span>
                    <span class={`font-mono text-[10px] px-2 py-0.5 rounded border uppercase tracking-wider ${a.badge}`}>
                      {exp.type}
                    </span>
                  </div>
                </div>

                <p class="text-text-muted text-sm leading-relaxed mb-4">{exp.description}</p>

                <ul class="space-y-1.5 mb-5">
                  {exp.highlights.map((h) => (
                    <li class="flex items-start gap-2.5 text-sm text-text-muted">
                      <span class="text-text-dim mt-1.5 shrink-0">—</span>
                      <span>{h}</span>
                    </li>
                  ))}
                </ul>

                <div class="flex flex-wrap gap-1.5">
                  {exp.stack.map((t) => (
                    <span class="tag">{t}</span>
                  ))}
                </div>
              </div>
            </div>
          );
        })}
      </div>
    </div>

    <!-- Education -->
    <div class="mt-16 animate-on-scroll">
      <p class="section-label mb-6">Education</p>
      <div class="grid md:grid-cols-2 gap-5">
        {[
          {
            degree: 'Engineering Degree — Cloud & Computer Science',
            school: 'ESPRIT — École Supérieure Privée d\'Ingénierie et de Technologie',
            location: 'Ariana, Tunisia',
            period: 'Sep 2021 – Jul 2026',
            note: 'Graduated — Mention Très Bien · Thesis: Cloud-Native Open-Source SOC Platform',
          },
          {
            degree: 'Academic Exchange — Computer Science',
            school: 'Philipps-Universität Marburg',
            location: 'Marburg, Germany',
            period: 'Oct 2025 – Dec 2026',
            note: 'Exchange semester in the Computer Science department',
          },
        ].map((edu) => (
          <div class="card-base card-hover">
            <p class="text-sm font-semibold text-text-primary mb-1">{edu.degree}</p>
            <p class="text-sm text-text-muted mb-1">{edu.school}</p>
            <p class="font-mono text-xs text-text-dim mb-3">{edu.location} · {edu.period}</p>
            <p class="font-mono text-xs text-accent-cyan/70 italic">{edu.note}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
