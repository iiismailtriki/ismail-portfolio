    company: 'Flexos Tunisie',
    location: 'Tunis, Tunisia',
    period: 'Aug 2025 – Oct 2025',
    type: 'Internship',
    description:
      'First internship at Flexos, focused on hands-on cloud operations support — the groundwork ahead of the later thesis project.',
    highlights: [
      'Assisted in deploying and maintaining Linux-based cloud environments for security and monitoring systems',
      'Supported configuration and operation of containerized services using Docker',
      'Contributed to system monitoring pipelines and log management workflows',
      'Participated in infrastructure troubleshooting and environment validation',
    ],
    stack: ['Linux', 'Docker', 'Monitoring', 'Log Management'],
    accent: 'cyan',
  },
  {
    title: 'Cloud & DevOps Intern — International Innovation Program',
    company: 'PVG University / AIESEC',
    location: 'Pune, India',
    period: 'Jun 2025 – Aug 2025',
    type: 'International Internship',
    description:
      'International innovation program at an engineering university in Pune, India, working in an intercultural team on Vocallia, a cloud-based AI voice automation prototype.',
    highlights: [
      'Contributed to the technical design and validation of Vocallia, a cloud-based application prototype (APIs, backend services, speech-processing components)',
