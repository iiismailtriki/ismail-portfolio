---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { certifications } from '../data/certifications';
---

<section id="certifications" class="section !pt-0" aria-labelledby="certifications-title">
  <div class="container-page">
    <div class="reveal mb-10 max-w-2xl">
      <p class="section-label">Certifications</p>
      <h2 id="certifications-title" class="section-title">
        Verified <span class="text-accent-cyan italic">credentials.</span>
      </h2>
    </div>

    <div class="grid gap-5 md:grid-cols-3">
      {
        certifications.map((cert, i) => (
          <a
            href={cert.href}
            target="_blank"
            rel="noopener noreferrer"
            class="reveal card-base card-hover group flex items-center gap-5 md:flex-col md:items-start"
            style={`--reveal-delay: ${i * 60}ms`}
          >
            <Image src={cert.image} alt="" width={80} height={80} densities={[1, 2]} class="h-20 w-20 shrink-0 object-contain" />
            <div class="min-w-0 flex-1">
              <p class="font-mono text-[11px] tracking-widest text-text-dim uppercase">{cert.issuer} · {cert.level}</p>
              <p class="mt-1 leading-snug font-semibold text-text-primary group-hover:text-accent-cyan">{cert.name}</p>
              <p class="mt-2 inline-flex items-center gap-1 font-mono text-xs text-accent-cyan">
                Verify on Credly <Icon name="arrow-up-right" size={13} />
                <span class="sr-only">(opens in a new tab)</span>
              </p>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>
