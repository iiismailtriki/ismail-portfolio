---
import { withBase } from '../utils/paths';

// Skill lists match docs/content-source-of-truth.md ("Technologies confirmed by CV/repo evidence").
// `usedIn` points at where on this site each group is evidenced.
const skillGroups = [
  {
    category: 'CI/CD & Automation',
    glyph: '>_',
    skills: ['Jenkins', 'GitHub Actions', 'Bash / Shell scripting', 'Python (automation)'],
    usedIn: [
      { label: 'DevSecOps Tracker', href: '/#devsecops-deployment-tracker' },
      { label: 'Flexos thesis', href: '/#experience' },
    ],
  },
  {
    category: 'Containers & Orchestration',
    glyph: '⎈',
    skills: ['Kubernetes (k3s)', 'Docker', 'Helm', 'ArgoCD'],
    usedIn: [
      { label: 'DevSecOps Tracker', href: '/#devsecops-deployment-tracker' },
      { label: 'SOC Platform', href: '/#soc-platform' },
    ],
  },
  {
    category: 'Cloud & Infrastructure as Code',
    glyph: '{ }',
    skills: ['AWS', 'OpenStack', 'Proxmox VE', 'VMware ESXi', 'Terraform', 'Ansible'],
    usedIn: [
      { label: 'SOC Platform', href: '/#soc-platform' },
      { label: "Espr'Eats", href: '/#esprEats' },
    ],
  },
  {
    category: 'Security & Observability',
    glyph: '◇',
    skills: ['Wazuh', 'OpenSearch Security Analytics', 'Suricata', 'Zeek', 'TheHive', 'Cortex', 'Prometheus', 'Grafana', 'MITRE ATT&CK'],
    usedIn: [
      { label: 'SOC Platform', href: '/#soc-platform' },
      { label: "Espr'Eats", href: '/#esprEats' },
    ],
  },
  {
    category: 'Systems & Networking',
    glyph: '⌁',
    skills: ['Linux (Debian/Ubuntu/RHEL)', 'Netplan / iptables', 'DNS / DHCP', 'VLANs', 'OPNsense'],
    usedIn: [{ label: 'SOC Platform', href: '/#soc-platform' }],
  },
  {
    category: 'Development',
    glyph: '</>',
    skills: ['Java', 'Spring Boot', 'JavaScript', 'Angular', 'REST APIs', 'OpenAI API'],
    usedIn: [
      { label: "Espr'Eats", href: '/#esprEats' },
      { label: 'Vocallia', href: '/#vocallia' },
    ],
  },
];
---

<section id="skills" class="section" aria-labelledby="skills-title">
  <div class="container-page">
    <div class="reveal mb-12 max-w-2xl">
      <p class="section-label">Skills</p>
      <h2 id="skills-title" class="section-title">
        Tools I've used<br />
        <span class="text-accent-cyan italic">on real systems.</span>
      </h2>
      <p class="section-intro">Grouped by discipline, with a pointer to where each group shows up in my work.</p>
    </div>

    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        skillGroups.map((group, i) => (
          <article class="reveal card-base card-hover flex flex-col" style={`--reveal-delay: ${(i % 3) * 60}ms`}>
            <div class="mb-4 flex items-center gap-3">
              <span class="grid h-9 min-w-9 place-items-center rounded-lg border border-accent-cyan/25 bg-accent-cyan/10 px-1.5 font-mono text-xs text-accent-cyan" aria-hidden="true">
                {group.glyph}
              </span>
              <h3 class="text-sm font-semibold text-text-primary">{group.category}</h3>
            </div>
            <ul class="flex flex-wrap gap-1.5">
              {group.skills.map((skill) => <li class="tag">{skill}</li>)}
            </ul>
            <p class="mt-auto pt-5 font-mono text-[11px] text-text-dim">
              Used in{' '}
              {group.usedIn.map((u, j) => (
                <>
                  {j > 0 && ' · '}
                  <a href={withBase(u.href)} class="text-text-muted underline-offset-4 hover:text-accent-cyan hover:underline">
                    {u.label}
                  </a>
                </>
              ))}
            </p>
          </article>
        ))
      }
    </div>
  </div>
</section>
