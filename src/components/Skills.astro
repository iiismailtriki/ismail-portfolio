---
const skillGroups = [
  {
    category: 'Cloud & Infrastructure',
    icon: '☁',
    color: 'cyan',
    skills: ['AWS', 'OpenStack', 'Proxmox VE', 'VMware ESXi', 'Terraform', 'Ansible'],
  },
  {
    category: 'Containers & Orchestration',
    icon: '⎈',
    color: 'cyan',
    skills: ['Kubernetes (k3s)', 'Docker', 'Helm', 'ArgoCD'],
  },
  {
    category: 'Security & SOC',
    icon: '🛡',
    color: 'green',
    skills: ['Wazuh', 'OpenSearch Security Analytics', 'Suricata', 'Zeek', 'TheHive', 'Cortex', 'MITRE ATT&CK'],
  },
  {
    category: 'CI/CD & Automation',
    icon: '⚡',
    color: 'amber',
    skills: ['Jenkins', 'GitHub Actions', 'Bash / Shell scripting', 'Python (automation)'],
  },
  {
    category: 'Development',
    icon: '{}',
    color: 'cyan',
    skills: ['Java', 'Spring Boot', 'JavaScript', 'Angular', 'REST APIs', 'OpenAI API'],
  },
  {
    category: 'Systems & Networking',
    icon: '⊟',
    color: 'green',
    skills: ['Linux (Debian/Ubuntu/RHEL)', 'Netplan / iptables', 'DNS / DHCP', 'VLANs', 'OPNsense'],
  },
];

const colorMap: Record<string, string> = {
  cyan: 'border-accent-cyan/20 bg-accent-cyan/5',
  green: 'border-accent-green/20 bg-accent-green/5',
  amber: 'border-accent-amber/20 bg-accent-amber/5',
};

const iconColorMap: Record<string, string> = {
  cyan: 'text-accent-cyan',
  green: 'text-accent-green',
  amber: 'text-accent-amber',
};
---

<section id="skills" class="py-24 bg-bg-800/40">
  <div class="max-w-6xl mx-auto px-6">
    <div class="max-w-xl mb-14 animate-on-scroll">
      <p class="section-label">Skills</p>
      <h2 class="section-title">
        Tools I build<br />
        <span class="text-accent-cyan italic">real systems with.</span>
      </h2>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {skillGroups.map((group, i) => (
        <div
          class={`card-base card-hover border ${colorMap[group.color]} animate-on-scroll`}
          style={`animation-delay: ${i * 0.07}s`}
        >
          <div class="flex items-center gap-3 mb-4">
            <span class={`text-xl ${iconColorMap[group.color]}`}>{group.icon}</span>
            <p class="text-sm font-semibold text-text-primary">{group.category}</p>
          </div>
          <div class="flex flex-wrap gap-2">
            {group.skills.map((skill) => (
              <span class="tag hover:text-text-primary hover:border-bg-600/80 transition-colors cursor-default">
                {skill}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
