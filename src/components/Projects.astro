---
import Icon from './Icon.astro';
import { withBase } from '../utils/paths';

// Order and wording follow docs/content-source-of-truth.md ("Project hierarchy").
// Only describe what the repository / approved sources evidence; planned work goes in `next`.

interface Project {
  id: string;
  label: string;
  status: 'Active' | 'Completed' | 'Prototype';
  role: string;
  title: string;
  subtitle: string;
  problem: string;
  built: string[];
  metric?: { value: string; text: string; scope: string };
  next?: string;
  stack: string[];
  caseStudy?: string;
  trackCaseStudy?: string;
  github?: string;
  trackGitHub?: string;
  note?: string;
}

const featured: Project[] = [
  {
    id: 'devsecops-deployment-tracker',
    label: 'Personal project',
    status: 'Active',
    role: 'Solo project — design, pipeline, and manifests',
    title: 'DevSecOps Deployment Tracker',
    subtitle: 'Signed, attested container pipeline for a Flask API, with hardened Kubernetes manifests',
    problem:
      'Most pipelines stop at "tests pass". This one goes further: prove what is running — every image scanned, signed, attested, and pinned by digest before Kubernetes ever references it.',
    built: [
      '14-stage Jenkins pipeline: Gitleaks secret scan, pytest, Ruff, Bandit, pip-audit and Hadolint run before any image is built',
      'Trivy fails the build on fixable HIGH/CRITICAL CVEs; findings in Debian base packages were fixed by pinning patched versions, not suppressed',
      'Syft CycloneDX SBOM, private GHCR publish by digest, Cosign signing — SBOM and SLSA provenance attached as verified in-toto attestations',
      'Kubernetes manifests and a Helm chart: digest-pinned image, non-root UID 10001, all capabilities dropped, seccomp RuntimeDefault, probes, resource limits, NetworkPolicy',
    ],
    next: 'Next: validate the NetworkPolicy on a live cluster and set readOnlyRootFilesystem.',
    stack: ['Jenkins', 'Docker', 'Trivy', 'Syft', 'Cosign', 'GHCR', 'Kubernetes', 'Helm', 'Python / Flask'],
    caseStudy: withBase('/devsecops-case-study/'),
    trackCaseStudy: 'DevSecOps Case Study Click',
    github: 'https://github.com/iiismailtriki/devsecops-deployment-tracker',
    trackGitHub: 'DevSecOps Tracker GitHub Click',
  },
  {
    id: 'soc-platform',
    label: 'Graduation thesis (PFE)',
    status: 'Completed',
    role: 'Thesis internship at Flexos Tunisie',
    title: 'Cloud-Native SOC Platform',
    subtitle: 'Open-source SIEM / EDR / IDS stack on a three-node k3s cluster',
    problem:
      'Build a working security-operations platform from open-source tools — detection, log analytics, network IDS and case management — orchestrated on Kubernetes and deployed on bare-metal Proxmox.',
    built: [
      'Three-node k3s cluster on Proxmox VE — static networking, persistent storage, production-grade configuration',
      'Integrated Wazuh (EDR/HIDS), Suricata and Zeek (network IDS), and OpenSearch Security Analytics for SIEM capabilities',
      'TheHive + Cortex for automated alert triage, case management, and threat-intelligence enrichment',
      'Custom MITRE ATT&CK–mapped detection rules (T1110.001, T1548.003, T1046, T1087.001); infrastructure provisioned with Terraform and Ansible',
    ],
    metric: {
      value: '<4 s',
      text: 'SSH brute-force detection and automated containment',
      scope: 'Validated lab scenario',
    },
    stack: ['k3s', 'Wazuh', 'OpenSearch', 'Suricata', 'Zeek', 'TheHive', 'Cortex', 'Proxmox VE', 'Terraform', 'Ansible'],
    caseStudy: withBase('/soc-case-study/'),
    trackCaseStudy: 'SOC Case Study Click',
  },
];

const more: Project[] = [
  {
    id: 'esprEats',
    label: 'Academic team project',
    status: 'Completed',
    role: 'University team project',
    title: "Espr'Eats — OpenStack Cloud Infrastructure",
    subtitle: 'Private cloud deployment for a campus meal-ordering app',
    problem:
      'University team project centred on deploying a full-stack application on private OpenStack infrastructure, provisioned and operated with infrastructure-as-code.',
    built: [
      'Angular + Spring Boot application deployed on a private OpenStack cloud',
      'Infrastructure provisioned with Terraform, configured with Ansible, orchestrated with Kubernetes',
      'Deployed infrastructure monitored with Prometheus and Grafana',
    ],
    stack: ['OpenStack', 'Kubernetes', 'Terraform', 'Ansible', 'Prometheus', 'Grafana'],
    caseStudy: withBase('/espreats-case-study/'),
    trackCaseStudy: "Espr'Eats Case Study Click",
  },
  {
    id: 'vocallia',
    label: 'Team · International innovation program',
    status: 'Prototype',
    role: 'Multicultural team, PVG University / AIESEC, Pune',
    title: 'Vocallia',
    subtitle: 'Cloud-oriented AI voice automation prototype',
    problem:
      'An AI phone-assistant startup initiative: a prototype that automates phone interactions and voice workflows, connecting callers to AI-powered voice services through APIs and backend services.',
    built: [
      'Contributed to technical design and cloud-oriented architecture',
      'Built backend and API integration components; helped structure application configuration',
      'Validated the end-to-end workflow between components ahead of deployment',
      'Selected Top 10 at OSTX Tunisia 2025',
    ],
    stack: ['APIs', 'Backend services', 'Speech processing', 'Git'],
    note: 'No public repository or demo.',
  },
];

const statusClass: Record<Project['status'], string> = {
  Active: 'border-accent-cyan/30 bg-accent-cyan/10 text-accent-cyan',
  Completed: 'border-accent-green/30 bg-accent-green/10 text-accent-green',
  Prototype: 'border-accent-amber/30 bg-accent-amber/10 text-accent-amber',
};
---

<section id="projects" class="section" aria-labelledby="projects-title">
  <div class="container-page">
    <div class="reveal mb-12 max-w-2xl">
      <p class="section-label">Projects</p>
      <h2 id="projects-title" class="section-title">
        Things I've built,<br />
        <span class="text-accent-cyan italic">and how they work.</span>
      </h2>
      <p class="section-intro">
        Each project separates what is implemented from what is planned. Case studies cover architecture,
        decisions, and the problems I ran into.
      </p>
    </div>

    <div class="space-y-6">
      {
        featured.map((p, i) => (
          <article id={p.id} class="reveal card-base card-hover overflow-hidden !p-0" style={`--reveal-delay: ${i * 60}ms`} aria-labelledby={`${p.id}-title`}>
            <div class="grid lg:grid-cols-[1fr_300px]">
              <div class="p-6 sm:p-8">
                <div class="mb-4 flex flex-wrap items-center gap-2">
                  <span class="chip border-bg-600 text-text-muted">{p.label}</span>
                  <span class={`chip ${statusClass[p.status]}`}>{p.status}</span>
                </div>
                <h3 id={`${p.id}-title`} class="font-display text-2xl text-text-primary sm:text-3xl">
                  {p.title}
                </h3>
                <p class="mt-1 text-text-muted">{p.subtitle}</p>
                <p class="mt-5 border-l-2 border-accent-cyan/40 pl-4 text-sm leading-relaxed text-text-muted">{p.problem}</p>

                <h4 class="mt-6 mb-3 font-mono text-[11px] tracking-widest text-text-dim uppercase">What's implemented</h4>
                <ul class="space-y-2.5">
                  {p.built.map((item) => (
                    <li class="flex gap-3 text-sm leading-relaxed text-text-muted">
                      <Icon name="check" size={14} class="mt-1 shrink-0 text-accent-green" />
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
                {p.next && (
                  <p class="mt-4 flex gap-3 text-sm text-text-muted">
                    <Icon name="circle" size={14} class="mt-1 shrink-0 text-accent-amber" />
                    <span>{p.next}</span>
                  </p>
                )}
              </div>

              <aside class="flex flex-col gap-6 border-t border-bg-600 bg-bg-800/60 p-6 sm:p-8 lg:border-t-0 lg:border-l" aria-label={`${p.title} summary`}>
                {p.metric && (
                  <div class="rounded-xl border border-accent-green/25 bg-accent-green/5 p-4">
                    <p class="font-display text-4xl text-accent-green">{p.metric.value}</p>
                    <p class="mt-1 text-sm text-text-primary">{p.metric.text}</p>
                    <p class="mt-1 font-mono text-[11px] text-text-dim uppercase">{p.metric.scope}</p>
                  </div>
                )}
                <div>
                  <p class="font-mono text-[11px] tracking-widest text-text-dim uppercase">Role</p>
                  <p class="mt-1 text-sm text-text-primary">{p.role}</p>
                </div>
                <div>
                  <p class="mb-2 font-mono text-[11px] tracking-widest text-text-dim uppercase">Stack</p>
                  <ul class="flex flex-wrap gap-1.5">
                    {p.stack.map((t) => <li class="tag">{t}</li>)}
                  </ul>
                </div>
                <div class="mt-auto flex flex-col gap-2">
                  {p.caseStudy && (
                    <a href={p.caseStudy} class="btn-primary w-full" data-track={p.trackCaseStudy}>
                      Read case study <Icon name="arrow-right" size={15} />
                    </a>
                  )}
                  {p.github && (
                    <a href={p.github} target="_blank" rel="noopener noreferrer" class="btn-ghost w-full" data-track={p.trackGitHub}>
                      <Icon name="github" size={15} /> View repository
                    </a>
                  )}
                </div>
              </aside>
            </div>
          </article>
        ))
      }
    </div>

    <h3 class="reveal mt-14 mb-5 font-mono text-xs tracking-[0.2em] text-text-dim uppercase">Team projects</h3>
    <div class="grid gap-6 md:grid-cols-2">
      {
        more.map((p, i) => (
          <article id={p.id} class="reveal card-base card-hover flex flex-col" style={`--reveal-delay: ${i * 60}ms`} aria-labelledby={`${p.id}-title`}>
            <div class="mb-4 flex flex-wrap items-center gap-2">
              <span class="chip border-bg-600 text-text-muted">{p.label}</span>
              <span class={`chip ${statusClass[p.status]}`}>{p.status}</span>
            </div>
            <h4 id={`${p.id}-title`} class="font-display text-2xl text-text-primary">{p.title}</h4>
            <p class="mt-1 text-sm text-text-muted">{p.subtitle}</p>
            <p class="mt-4 text-sm leading-relaxed text-text-muted">{p.problem}</p>
            <ul class="mt-4 space-y-2">
              {p.built.map((item) => (
                <li class="flex gap-3 text-sm leading-relaxed text-text-muted">
                  <span class="mt-2.5 h-1 w-1 shrink-0 rounded-full bg-accent-cyan" aria-hidden="true" />
                  <span>{item}</span>
                </li>
              ))}
            </ul>
            <ul class="mt-5 flex flex-wrap gap-1.5">
              {p.stack.map((t) => <li class="tag">{t}</li>)}
            </ul>
            <div class="mt-auto pt-6">
              {p.caseStudy ? (
                <a href={p.caseStudy} class="link-arrow" data-track={p.trackCaseStudy}>
                  Read case study <Icon name="arrow-right" size={13} />
                </a>
              ) : (
                p.note && <p class="font-mono text-xs text-text-dim">{p.note}</p>
              )}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
