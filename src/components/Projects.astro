---
import Icon from './Icon.astro';
import { withBase } from '../utils/paths';

// Order and wording follow docs/content-source-of-truth.md ("Project hierarchy") and the approved CV.
// `built` = implemented and evidenced; `decisions` only where the repo/case study records the change;
// `limits` = not implemented, not validated, or planned. Re-audit the repo before editing the tracker.

interface Project {
  id: string;
  label: string;
  status: 'Active' | 'Completed' | 'Prototype';
  period?: string;
  role: string;
  title: string;
  subtitle: string;
  problem: string;
  built: string[];
  decisions?: string[];
  verified?: string[];
  limits: string[];
  metric?: { value: string; text: string; scope: string };
  stack: string[];
  evidence?: { label: string; href: string }[];
  caseStudy?: string;
  trackCaseStudy?: string;
  github?: string;
  trackGitHub?: string;
  note?: string;
}

const tracker = 'https://github.com/iiismailtriki/devsecops-deployment-tracker';

const featured: Project[] = [
  {
    id: 'devsecops-deployment-tracker',
    label: 'Personal project',
    status: 'Active',
    period: '2026',
    role: 'Solo — pipeline, Helm chart, security controls',
    title: 'DevSecOps Deployment Tracker',
    subtitle: 'Software supply-chain security for a containerized Flask service',
    problem:
      'Passing tests say little about what actually runs. The goal: make every container image traceable from commit to registry — scanned, inventoried, signed and attested — and refuse to publish anything that fails a security gate.',
    built: [
      '15-stage Jenkins pipeline: Gitleaks, pytest, Ruff, Bandit, pip-audit and Hadolint gate the code before an image is built',
      'Kubernetes IaC gate: the Helm chart is linted, rendered and scanned with Trivy; HIGH/CRITICAL misconfigurations fail the build',
      'Trivy image scan blocks fixable HIGH/CRITICAL CVEs; Syft produces a CycloneDX SBOM',
      'On main only: publish to private GHCR by digest, sign with Cosign, attach SBOM and SLSA provenance as verified attestations',
      'Helm chart runs the digest-pinned image as non-root with a read-only root filesystem, dropped capabilities, seccomp, probes, resource limits and a NetworkPolicy',
    ],
    decisions: [
      'Gate on fixable findings only (--ignore-unfixed), so every failure points to a concrete remediation',
      'Reference images by digest everywhere downstream — a tag can move, a digest cannot',
      'Sign and attest only on main: feature branches are scanned but never produce signed release artifacts',
    ],
    verified: [
      'Signature, SBOM and provenance attestations re-verified with Cosign in the same run',
      'Real CVE findings fixed by pinning patched Debian packages (e.g. zlib), not suppressed',
      'Signing key lost in a laptop migration: rotated, legacy public key kept for older signatures, encrypted backup recovery-tested',
    ],
    limits: [
      'The pipeline ends at a signed image — it does not deploy to a cluster',
      'NetworkPolicy not yet validated on a live cluster; main-branch signing with the rotated key still pending validation',
    ],
    stack: ['Jenkins', 'Docker', 'Trivy', 'Syft', 'Cosign', 'GHCR', 'Helm', 'Kubernetes', 'Python / Flask'],
    evidence: [
      { label: 'Jenkinsfile', href: `${tracker}/blob/main/Jenkinsfile` },
      { label: 'Helm chart', href: `${tracker}/tree/main/helm/deployment-tracker` },
      { label: 'Key rotation record', href: `${tracker}/blob/main/docs/signing/KEY_ROTATION.md` },
    ],
    caseStudy: withBase('/devsecops-case-study/'),
    trackCaseStudy: 'DevSecOps Case Study Click',
    github: tracker,
    trackGitHub: 'DevSecOps Tracker GitHub Click',
  },
  {
    id: 'soc-platform',
    label: 'Graduation thesis (PFE)',
    status: 'Completed',
    period: 'Dec 2025 – Jun 2026',
    role: 'Thesis internship at Flexos Tunisie',
    title: 'Cloud-Native SOC Platform',
    subtitle: 'Open-source detection and response on a three-node k3s cluster',
    problem:
      'Detection alone is not enough — the response has to be fast and repeatable. Build a working detection-and-response chain from open-source tools (host and network detection, log analytics, case management) on Kubernetes, and measure how quickly it reacts.',
    built: [
      'Three-node k3s cluster on Proxmox VE with static networking and persistent storage',
      'Wazuh (EDR/HIDS), Suricata and Zeek (network IDS) and OpenSearch analytics, feeding case handling in TheHive with Cortex and Shuffle SOAR',
      'Custom MITRE ATT&CK–mapped detection rules (T1110.001, T1548.003, T1046, T1087.001)',
      'Provisioning and deployment automated with Terraform, Ansible, AWX and GitHub Actions',
    ],
    decisions: [
      'Detection rules moved from a PVC to a read-only ConfigMap after they were lost on pod restarts',
      'Wazuh → TheHive escalation threshold raised from level 10 to 12 after noise produced 843 cases',
    ],
    verified: [
      'Each rule validated against a simulated attack: SSH brute force, sudo privilege escalation, network reconnaissance, Windows account discovery',
    ],
    metric: {
      value: '<4 s',
      text: 'SSH brute-force detection to automated containment',
      scope: 'Controlled lab testing',
    },
    limits: ['Measured in a controlled lab scenario only — not under production traffic or at production scale'],
    stack: ['k3s', 'Wazuh', 'Suricata', 'OpenSearch', 'TheHive', 'Shuffle', 'Proxmox VE', 'Terraform', 'Ansible', 'AWX'],
    caseStudy: withBase('/soc-case-study/'),
    trackCaseStudy: 'SOC Case Study Click',
  },
];

const more: Project[] = [
  {
    id: 'esprEats',
    label: 'Academic team project',
    status: 'Completed',
    period: '2024 – 2025',
    role: 'University team project, ESPRIT',
    title: "Espr'Eats — OpenStack Cloud Infrastructure",
    subtitle: 'Private cloud provisioning and operations for a full-stack app',
    problem:
      'Run a full-stack application on private OpenStack infrastructure that the team provisions, configures and monitors as code.',
    built: [
      'OpenStack compute and networking provisioned with Terraform, configured with Ansible',
      'Spring Boot and Angular services containerized and run on Kubernetes via CI/CD',
      'Deployed infrastructure monitored with Prometheus and Grafana',
    ],
    limits: ['Team project — work is described collectively'],
    stack: ['OpenStack', 'Terraform', 'Ansible', 'Kubernetes', 'Prometheus', 'Grafana'],
    caseStudy: withBase('/espreats-case-study/'),
    trackCaseStudy: "Espr'Eats Case Study Click",
  },
  {
    id: 'vocallia',
    label: 'Team · International innovation program',
    status: 'Prototype',
    period: 'Jun – Aug 2025',
    role: 'Co-designer in a multicultural team, PVG University / AIESEC, Pune',
    title: 'Vocallia',
    subtitle: 'AI voice-automation prototype for a phone-assistant startup idea',
    problem:
      'The longer-term idea was an AI phone-assistant startup that automates phone interactions and voice workflows. What was built during the program is a prototype.',
    built: [
      'Contributed to the technical design and cloud-oriented architecture',
      'Built backend and API integration components; helped structure application configuration',
      'Validated the end-to-end workflow between components ahead of deployment',
      'Selected Top 10 at OSTX Tunisia 2025',
    ],
    limits: ['Prototype only — no production deployment, customers or revenue'],
    stack: ['APIs', 'Backend services', 'Speech processing', 'Git'],
    note: 'No public repository or demo.',
  },
];

const statusClass: Record<Project['status'], string> = {
  Active: 'border-accent-cyan/30 bg-accent-cyan/10 text-accent-cyan',
  Completed: 'border-accent-green/30 bg-accent-green/10 text-accent-green',
  Prototype: 'border-accent-amber/30 bg-accent-amber/10 text-accent-amber',
};
---

<section id="projects" class="section" aria-labelledby="projects-title">
  <div class="container-page">
    <div class="reveal mb-12 max-w-2xl">
      <p class="section-label">Projects</p>
      <h2 id="projects-title" class="section-title">
        Systems I've built,<br />
        <span class="text-accent-cyan italic">and how I checked them.</span>
      </h2>
      <p class="section-intro">
        Each project states the problem, what is implemented, how it was verified, and what is not done yet.
        Case studies go deeper into architecture and the issues I had to fix.
      </p>
    </div>

    <div class="space-y-6">
      {
        featured.map((p, i) => (
          <article id={p.id} class="reveal card-base card-hover overflow-hidden !p-0" style={`--reveal-delay: ${i * 60}ms`} aria-labelledby={`${p.id}-title`}>
            <div class="grid lg:grid-cols-[1fr_300px]">
              <div class="p-6 sm:p-8">
                <div class="mb-4 flex flex-wrap items-center gap-2">
                  <span class="chip border-bg-600 text-text-muted">{p.label}</span>
                  <span class={`chip ${statusClass[p.status]}`}>{p.status}</span>
                  {p.period && <span class="font-mono text-xs text-text-dim">{p.period}</span>}
                </div>
                <h3 id={`${p.id}-title`} class="font-display text-2xl text-text-primary sm:text-3xl">
                  {p.title}
                </h3>
                <p class="mt-1 text-text-muted">{p.subtitle}</p>

                <p class="mt-5 border-l-2 border-accent-cyan/40 pl-4 text-sm leading-relaxed text-text-muted">
                  <span class="mb-1 block font-mono text-[11px] tracking-widest text-accent-cyan uppercase">Problem</span>
                  {p.problem}
                </p>

                <h4 class="mt-6 mb-3 font-mono text-[11px] tracking-widest text-text-dim uppercase">What's implemented</h4>
                <ul class="space-y-2.5">
                  {p.built.map((item) => (
                    <li class="flex gap-3 text-sm leading-relaxed text-text-muted">
                      <Icon name="check" size={14} class="mt-1 shrink-0 text-accent-green" />
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>

                <div class="mt-6 grid gap-6 md:grid-cols-2">
                  {p.decisions && (
                    <div>
                      <h4 class="mb-3 font-mono text-[11px] tracking-widest text-text-dim uppercase">Decisions</h4>
                      <ul class="space-y-2">
                        {p.decisions.map((d) => (
                          <li class="flex gap-3 text-sm leading-relaxed text-text-muted">
                            <span class="mt-2.5 h-1 w-1 shrink-0 rounded-full bg-accent-cyan" aria-hidden="true" />
                            <span>{d}</span>
                          </li>
                        ))}
                      </ul>
                    </div>
                  )}
                  {p.verified && (
                    <div>
                      <h4 class="mb-3 font-mono text-[11px] tracking-widest text-text-dim uppercase">How it was verified</h4>
                      <ul class="space-y-2">
                        {p.verified.map((v) => (
                          <li class="flex gap-3 text-sm leading-relaxed text-text-muted">
                            <span class="mt-2.5 h-1 w-1 shrink-0 rounded-full bg-accent-green" aria-hidden="true" />
                            <span>{v}</span>
                          </li>
                        ))}
                      </ul>
                    </div>
                  )}
                </div>

                <div class="mt-6 rounded-xl border border-accent-amber/20 bg-accent-amber/5 p-4">
                  <h4 class="mb-2 font-mono text-[11px] tracking-widest text-accent-amber uppercase">Limits &amp; next steps</h4>
                  <ul class="space-y-1.5">
                    {p.limits.map((l) => (
                      <li class="flex gap-3 text-sm leading-relaxed text-text-muted">
                        <Icon name="circle" size={13} class="mt-1 shrink-0 text-accent-amber" />
                        <span>{l}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>

              <aside class="flex flex-col gap-6 border-t border-bg-600 bg-bg-800/60 p-6 sm:p-8 lg:border-t-0 lg:border-l" aria-label={`${p.title} summary`}>
                {p.metric && (
                  <div class="rounded-xl border border-accent-green/25 bg-accent-green/5 p-4">
                    <p class="font-display text-4xl text-accent-green">{p.metric.value}</p>
                    <p class="mt-1 text-sm text-text-primary">{p.metric.text}</p>
                    <p class="mt-1 font-mono text-[11px] text-text-dim uppercase">{p.metric.scope}</p>
                  </div>
                )}
                <div>
                  <p class="font-mono text-[11px] tracking-widest text-text-dim uppercase">Role</p>
                  <p class="mt-1 text-sm text-text-primary">{p.role}</p>
                </div>
                <div>
                  <p class="mb-2 font-mono text-[11px] tracking-widest text-text-dim uppercase">Stack</p>
                  <ul class="flex flex-wrap gap-1.5">
                    {p.stack.map((t) => <li class="tag">{t}</li>)}
                  </ul>
                </div>
                {p.evidence && (
                  <div>
                    <p class="mb-2 font-mono text-[11px] tracking-widest text-text-dim uppercase">Evidence in the repo</p>
                    <ul class="space-y-1.5">
                      {p.evidence.map((e) => (
                        <li>
                          <a href={e.href} target="_blank" rel="noopener noreferrer" class="link-arrow">
                            {e.label} <Icon name="arrow-up-right" size={12} />
                            <span class="sr-only">(opens in a new tab)</span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                )}
                <div class="mt-auto flex flex-col gap-2">
                  {p.caseStudy && (
                    <a href={p.caseStudy} class="btn-primary w-full" data-track={p.trackCaseStudy}>
                      Read case study <Icon name="arrow-right" size={15} />
                    </a>
                  )}
                  {p.github && (
                    <a href={p.github} target="_blank" rel="noopener noreferrer" class="btn-ghost w-full" data-track={p.trackGitHub}>
                      <Icon name="github" size={15} /> View repository
                    </a>
                  )}
                </div>
              </aside>
            </div>
          </article>
        ))
      }
    </div>

    <h3 class="reveal mt-14 mb-5 font-mono text-xs tracking-[0.2em] text-text-dim uppercase">Team projects</h3>
    <div class="grid gap-6 md:grid-cols-2">
      {
        more.map((p, i) => (
          <article id={p.id} class="reveal card-base card-hover flex flex-col" style={`--reveal-delay: ${i * 60}ms`} aria-labelledby={`${p.id}-title`}>
            <div class="mb-4 flex flex-wrap items-center gap-2">
              <span class="chip border-bg-600 text-text-muted">{p.label}</span>
              <span class={`chip ${statusClass[p.status]}`}>{p.status}</span>
              {p.period && <span class="font-mono text-xs text-text-dim">{p.period}</span>}
            </div>
            <h4 id={`${p.id}-title`} class="font-display text-2xl text-text-primary">{p.title}</h4>
            <p class="mt-1 text-sm text-text-muted">{p.subtitle}</p>
            <p class="mt-4 text-sm leading-relaxed text-text-muted">{p.problem}</p>
            <ul class="mt-4 space-y-2">
              {p.built.map((item) => (
                <li class="flex gap-3 text-sm leading-relaxed text-text-muted">
                  <Icon name="check" size={14} class="mt-1 shrink-0 text-accent-green" />
                  <span>{item}</span>
                </li>
              ))}
            </ul>
            <p class="mt-4 flex gap-3 text-sm text-text-muted">
              <Icon name="circle" size={13} class="mt-1 shrink-0 text-accent-amber" />
              <span>{p.limits.join(' · ')}</span>
            </p>
            <ul class="mt-5 flex flex-wrap gap-1.5">
              {p.stack.map((t) => <li class="tag">{t}</li>)}
            </ul>
            <div class="mt-auto pt-6">
              {p.caseStudy ? (
                <a href={p.caseStudy} class="link-arrow" data-track={p.trackCaseStudy}>
                  Read case study <Icon name="arrow-right" size={13} />
                </a>
              ) : (
                p.note && <p class="font-mono text-xs text-text-dim">{p.note}</p>
              )}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
