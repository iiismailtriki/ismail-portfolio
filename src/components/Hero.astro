---
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import PipelineStrip from './PipelineStrip.astro';
import profile from '../assets/images/profile.png';
import { Image } from 'astro:assets';
import { site } from '../data/site';
import { certifications, primaryCertification as saa } from '../data/certifications';
import { withBase } from '../utils/paths';

// Wording follows the approved CV (v3.2) and docs/content-source-of-truth.md.
const facts = [
  { label: 'Certified', value: 'AWS Solutions Architect – Associate', sub: certifications.slice(1).map((c) => c.short).join(' · ') },
  { label: 'Experience', value: 'DevSecOps & security automation intern', sub: 'Flexos Tunisie · SOC platform thesis' },
  { label: 'Education', value: 'Engineering degree, Computer Science', sub: 'ESPRIT 2026 · Cloud specialization' },
  { label: 'Languages', value: 'English C1 · German B1', sub: 'French C1 · Arabic native' },
];
---

<section id="hero" class="relative overflow-hidden" aria-labelledby="hero-title">
  <div class="bg-grid pointer-events-none absolute inset-0" aria-hidden="true"></div>
  <div
    class="pointer-events-none absolute -top-40 left-1/2 h-[560px] w-[900px] -translate-x-1/2 rounded-full opacity-60 blur-3xl"
    style="background: radial-gradient(closest-side, rgb(56 189 248 / 0.12), transparent);"
    aria-hidden="true"
  >
  </div>

  <div class="container-page relative pt-28 pb-4 md:pt-36 md:pb-8">
    <div class="grid items-center gap-12 lg:grid-cols-[1.4fr_1fr]">
      <div>
        <div class="hero-in flex items-center gap-4" style="--d: 0ms">
          <span class="h-14 w-14 shrink-0 overflow-hidden rounded-full border border-bg-600 bg-bg-700 lg:hidden">
            <Picture
              src={profile}
              formats={['avif', 'webp']}
              width={168}
              height={168}
              alt=""
              class="h-full w-full origin-[50%_18%] scale-[1.9] object-cover"
              loading="eager"
            />
          </span>
          <p class="chip border-accent-green/30 bg-accent-green/10 text-accent-green">
            <span class="relative flex h-1.5 w-1.5" aria-hidden="true">
              <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-accent-green opacity-60 [animation-iteration-count:3]"></span>
              <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-accent-green"></span>
            </span>
            Open to junior roles · Germany
          </p>
        </div>

        <h1 id="hero-title" class="hero-in mt-6 font-display text-5xl leading-[1.02] text-text-primary sm:text-6xl lg:text-7xl" style="--d: 60ms">
          Ismail Triki
        </h1>
        <p class="hero-in mt-1 font-mono text-sm tracking-wide text-accent-cyan" style="--d: 90ms">
          Cloud · DevOps · DevSecOps engineer
        </p>
        <p class="hero-in mt-4 font-display text-2xl leading-snug text-text-primary/90 sm:text-3xl" style="--d: 120ms">
          Building secure cloud infrastructure and delivery pipelines{' '}
          <span class="text-accent-cyan italic">that can be verified.</span>
        </p>

        <a
          href={saa.href}
          target="_blank"
          rel="noopener noreferrer"
          class="hero-in group mt-5 inline-flex items-center gap-3 rounded-xl border border-bg-600 bg-bg-800/70 py-2 pr-4 pl-2 transition-colors hover:border-accent-cyan/40"
          style="--d: 150ms"
          data-track="SAA Credential Click"
        >
          <Image src={saa.image} alt="" width={40} height={40} densities={[1, 2]} class="h-10 w-10" loading="eager" />
          <span class="text-sm leading-tight">
            <span class="block font-medium text-text-primary">{saa.name}</span>
            <span class="inline-flex items-center gap-1 font-mono text-[11px] text-text-muted group-hover:text-accent-cyan">
              Verify on Credly <Icon name="arrow-up-right" size={12} />
            </span>
          </span>
          <span class="sr-only">(opens in a new tab)</span>
        </a>

        <p class="hero-in mt-5 max-w-[60ch] leading-relaxed text-text-muted" style="--d: 180ms">
          I automate infrastructure with Terraform and Ansible, run workloads on Kubernetes, and build CI/CD
          pipelines where security checks actually block a release. Recent work: a signed, attested container
          supply chain and a Kubernetes-based SOC platform. Looking for a junior{' '}
          <strong class="font-medium text-text-primary">Cloud, DevOps, Platform or DevSecOps</strong> role.
        </p>

        <div class="hero-in mt-8 flex flex-wrap items-center gap-3" style="--d: 240ms">
          <a href={withBase('/#projects')} class="btn-primary">
            View projects
            <Icon name="arrow-right" size={15} />
          </a>
          <a href={site.cv} download class="btn-ghost" data-track="CV Download">
            <Icon name="download" size={15} />
            CV (EN)
          </a>
          <a href={site.cvDe} download class="btn-ghost" data-track="CV DE Download" lang="de">
            <Icon name="download" size={15} />
            Lebenslauf (DE)
          </a>
          <div class="flex items-center gap-1 sm:ml-1">
            <a href={site.github} target="_blank" rel="noopener noreferrer" class="grid h-11 w-11 place-items-center rounded-lg text-text-muted hover:bg-bg-700 hover:text-text-primary" aria-label="GitHub profile" data-track="GitHub Click">
              <Icon name="github" size={18} />
            </a>
            <a href={site.linkedin} target="_blank" rel="noopener noreferrer" class="grid h-11 w-11 place-items-center rounded-lg text-text-muted hover:bg-bg-700 hover:text-text-primary" aria-label="LinkedIn profile" data-track="LinkedIn Click">
              <Icon name="linkedin" size={18} />
            </a>
            <a href={`mailto:${site.email}`} class="grid h-11 w-11 place-items-center rounded-lg text-text-muted hover:bg-bg-700 hover:text-text-primary" aria-label="Email Ismail" data-track="Email Contact Click">
              <Icon name="mail" size={18} />
            </a>
          </div>
        </div>
      </div>

      <!-- Portrait (desktop) -->
      <div class="hero-in relative hidden justify-self-end lg:block" style="--d: 100ms">
        <div class="relative w-[340px] overflow-hidden rounded-[28px] border border-bg-600 bg-linear-to-b from-bg-700 to-bg-900">
          <div class="bg-grid absolute inset-0 opacity-70" aria-hidden="true"></div>
          <Picture
            src={profile}
            formats={['avif', 'webp']}
            widths={[340, 500]}
            sizes="340px"
            alt="Portrait of Ismail Triki"
            class="relative h-auto w-full [mask-image:linear-gradient(to_bottom,black_70%,transparent)]"
            loading="eager"
            fetchpriority="high"
          />
          <div class="absolute inset-x-4 bottom-4 flex items-center gap-2 rounded-xl border border-bg-600 bg-bg-900/85 px-4 py-3 text-sm text-text-primary backdrop-blur">
            <Icon name="map-pin" size={15} class="text-accent-cyan" />
            Marburg, Germany
          </div>
        </div>
      </div>
    </div>

    <!-- At a glance -->
    <dl class="hero-in mt-10 grid grid-cols-2 gap-px overflow-hidden rounded-2xl border border-bg-600 bg-bg-600 md:grid-cols-4" style="--d: 300ms">
      {
        facts.map((fact) => (
          <div class="bg-bg-800 p-4 sm:p-5">
            <dt class="font-mono text-[11px] tracking-widest text-text-dim uppercase">{fact.label}</dt>
            <dd class="mt-1.5 text-sm leading-snug font-medium text-text-primary">{fact.value}</dd>
            <dd class="mt-0.5 text-xs text-text-muted">{fact.sub}</dd>
          </div>
        ))
      }
    </dl>

    <div class="hero-in mt-6" style="--d: 360ms">
      <PipelineStrip />
    </div>
  </div>
</section>

<style>
  /* One-shot entrance for above-the-fold content (no scroll observer needed, nothing loops). */
  @keyframes hero-in {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }
  :global(.js) .hero-in {
    animation: hero-in 0.7s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    animation-delay: var(--d, 0ms);
  }
</style>
