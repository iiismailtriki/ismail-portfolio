---

<style>
  /*
   * ENTRANCE — outer wrapper only, one-shot.
   * Owns opacity + the initial translate/scale. Never loops.
   */
  @keyframes hero-portrait-enter {
    from {
      opacity: 0;
      transform: translateY(40px) translateX(-20px) scale(0.96);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .portrait-enter-wrapper {
    animation: hero-portrait-enter 1.1s cubic-bezier(0.25, 1, 0.35, 1) 0.15s both;
  }

  /*
   * FLOAT — inner wrapper only, infinite.
   * Owns its own transform independently of the entrance layer.
   * Delay = entrance delay + duration (0.15 + 1.1 = 1.25s) so it starts
   * exactly when the outer wrapper settles — zero-gap, zero-jump.
   */
  @keyframes portrait-float {
    0%, 100% { transform: translateY(0px); }
    50%       { transform: translateY(-5px); }
  }

  .portrait-float-inner {
    animation: portrait-float 7s ease-in-out 1.25s infinite;
  }

  /*
   * GLOW BREATHING — depth glow div.
   * 0.5s phase offset keeps it visually desynced from the float.
   */
  @keyframes glow-breathe {
    0%, 100% { opacity: 1;   transform: scale(1); }
    50%       { opacity: 0.5; transform: scale(1.08); }
  }

  .portrait-depth-glow {
    animation: glow-breathe 8s ease-in-out 0.5s infinite;
  }

  .hero-headline {
    text-shadow: 0 0 40px rgba(10, 13, 18, 0.6);
  }

  /*
   * REDUCED MOTION — keep the one-shot entrance (it's brief and functional),
   * silence all infinite loops.
   */
  @media (prefers-reduced-motion: reduce) {
    .portrait-enter-wrapper {
      animation: hero-portrait-enter 1.1s cubic-bezier(0.25, 1, 0.35, 1) 0.15s both;
    }
    .portrait-float-inner  { animation: none; }
    .portrait-depth-glow   { animation: none; }
  }
</style>

<section id="hero" class="relative min-h-screen flex items-center overflow-hidden">

  <!-- Background grid -->
  <div class="absolute inset-0 opacity-[0.03]"
    style="background-image: linear-gradient(#38bdf8 1px, transparent 1px),
           linear-gradient(90deg, #38bdf8 1px, transparent 1px);
           background-size: 60px 60px;"></div>

  <!-- Central ambient glow -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2
              w-[800px] h-[600px] rounded-full opacity-[0.04]"
    style="background: radial-gradient(ellipse, #38bdf8 0%, transparent 70%);"></div>

  <!-- Noise grain -->
  <div class="absolute inset-0 opacity-[0.015]"
    style="background-image: url('data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 width=%22200%22 height=%22200%22><filter id=%22n%22><feTurbulence type=%22fractalNoise%22 baseFrequency=%220.9%22 numOctaves=%224%22/></filter><rect width=%22200%22 height=%22200%22 filter=%22url(%23n)%22 opacity=%221%22/></svg>');"></div>

  <div class="relative max-w-5xl mx-auto px-6 pt-32 pb-12 w-full">

    <!--
      SCENE GLOW
      One large, very soft radial that covers the portrait area and fades into
      the title block. Hot point at ~28% (portrait center). Max opacity: 0.10.
      This is atmospheric light, not a spotlight — premium, not gaming.
    -->
    <div class="absolute pointer-events-none hidden md:block"
      style="
        top: 50%;
        left: -16px;
        transform: translateY(-52%);
        width: 660px;
        height: 560px;
        background: radial-gradient(
          ellipse at 30% 46%,
          rgba(56,189,248,0.10) 0%,
          rgba(56,189,248,0.03) 44%,
          transparent 68%
        );
        filter: blur(60px);
      ">
    </div>

    <!--
      BRIDGE GLOW
      Directional soft light that originates behind the portrait and extends
      toward the headline — visually binds subject and title into one scene.
      Hot point sits at the portrait column; the gradient trails rightward.
    -->
    <div class="absolute pointer-events-none hidden md:block"
      style="
        top: 14%;
        left: 2%;
        width: 68%;
        height: 260px;
        background: radial-gradient(
          ellipse at 22% 54%,
          rgba(56,189,248,0.065) 0%,
          rgba(56,189,248,0.018) 42%,
          transparent 64%
        );
        filter: blur(52px);
      ">
    </div>

    <!--
      HERO GRID
      Portrait: 1fr — fills the column, image justified to the RIGHT edge so it
        sits flush against the gap toward the title. No DOM overlap needed; the
        shared glow and tight gap create the visual connection.
      Text: 1.5fr — dominant column, gets more horizontal space.
      items-start + md:pt-8 on portrait wrapper → portrait image top lands
        roughly at "Ismail Triki" level, not at the button row level.
    -->
    <div class="grid grid-cols-1 md:grid-cols-[1fr_1.5fr] items-start gap-6 md:gap-10 lg:gap-14">

      <!-- =====================
          PORTRAIT COLUMN
          ===================== -->
      <div class="relative z-0 flex justify-center md:justify-end md:pt-8">

        <!--
          Depth glow — very low opacity (0.12), positioned at mid-torso.
          Creates warmth and depth without the "sticker" effect.
          blur(28px) is enough to be visible without being harsh.
        -->
        <div class="portrait-depth-glow absolute inset-0 pointer-events-none"
          style="
            background: radial-gradient(
              ellipse at 55% 55%,
              rgba(56,189,248,0.12) 0%,
              transparent 65%
            );
            filter: blur(28px);
          ">
        </div>

        <!--
          Profile image.
          drop-shadow values are deliberately conservative:
            — tight shadow (6px): just enough glow to make the subject
              feel lit, not to create an outline or halo
            — wide shadow (30px): very soft ambient spread at 0.09 opacity
          Result: subject looks naturally integrated into the dark scene.
        -->
        <!-- outer: entrance only (one-shot translate + opacity) -->
        <div class="portrait-enter-wrapper">
          <!-- inner: float only (isolated transform, no conflict with entrance) -->
          <div class="portrait-float-inner">
            <img
              src="/profile.png"
              alt="Ismail Triki profile photo"
              class="relative select-none
                     h-[240px] sm:h-[275px]
                     md:h-[485px] lg:h-[530px] xl:h-[550px]
                     w-auto object-contain object-top"
              style="
                max-width: 330px;
                filter:
                  drop-shadow(0 0 6px  rgba(56,189,248,0.14))
                  drop-shadow(0 0 30px rgba(56,189,248,0.07));
                -webkit-mask-image: linear-gradient(to bottom, black 62%, transparent 97%);
                mask-image: linear-gradient(to bottom, black 62%, transparent 97%);
              "
            />
          </div>
        </div>
      </div>

      <!-- =====================
          TEXT COLUMN
          ===================== -->
      <div class="relative z-10">

        <!-- Availability indicator -->
        <div class="flex items-center gap-3 mb-5 animate-on-scroll">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-accent-green opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-accent-green"></span>
          </span>
          <span class="font-mono text-xs text-text-muted tracking-widest uppercase">
            Available — Marburg, Germany
          </span>
        </div>

        <!-- Main headline -->
        <h1
          class="hero-headline font-display text-5xl md:text-6xl lg:text-7xl text-text-primary leading-[1.05] mb-5 animate-on-scroll"
          style="animation-delay: 0.1s;"
        >
          Ismail Triki
          <span class="block text-accent-cyan mt-2">Cloud &amp; Security</span>
          <span class="block text-text-muted text-4xl md:text-5xl mt-2">Engineering.</span>
        </h1>

        <!-- Subtitle -->
        <p
          class="text-text-muted text-base md:text-lg leading-relaxed mb-7 animate-on-scroll"
          style="animation-delay: 0.2s; max-width: 46ch;"
        >
          Final-year engineering student in Cloud, DevOps, DevSecOps, and Security
          Engineering — based in Marburg, Germany.
        </p>

        <!-- Stack tags -->
        <div class="flex flex-wrap gap-2 mb-7 animate-on-scroll" style="animation-delay: 0.3s;">
          {['AWS', 'Kubernetes', 'Terraform', 'Wazuh', 'OpenSearch', 'Linux'].map((t) => (
            <span class="font-mono text-xs text-text-dim border border-bg-600 px-3 py-1 rounded-full">
              {t}
            </span>
          ))}
        </div>

        <!-- CTA buttons -->
        <div class="flex flex-wrap items-center gap-3 animate-on-scroll" style="animation-delay: 0.4s;">
          <a href="#projects" class="btn-primary font-semibold">
            View Projects
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <line x1="5" y1="12" x2="19" y2="12"/>
              <polyline points="12 5 19 12 12 19"/>
            </svg>
          </a>

          <a href="https://github.com/iiismailtriki" target="_blank" rel="noopener noreferrer" class="btn-ghost">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.44 9.8 8.21 11.39.6.11.82-.26.82-.58v-2.03c-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.09-.74.08-.73.08-.73 1.21.09 1.84 1.24 1.84 1.24 1.07 1.84 2.81 1.3 3.5.99.11-.78.42-1.3.76-1.6-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.13-.3-.54-1.52.12-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 3-.4c1.02.005 2.04.138 3 .4 2.28-1.55 3.29-1.23 3.29-1.23.66 1.66.25 2.88.12 3.18.77.84 1.24 1.91 1.24 3.22 0 4.61-2.81 5.63-5.48 5.92.43.37.81 1.1.81 2.22v3.29c0 .32.21.7.82.58C20.56 21.8 24 17.3 24 12c0-6.63-5.37-12-12-12z"/>
            </svg>
            GitHub
          </a>

          <a href="https://www.linkedin.com/in/ismail-triki-3571a21a7/" target="_blank" rel="noopener noreferrer" class="btn-ghost">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
              <path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.95v5.66H9.37V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.36-1.85 3.59 0 4.26 2.36 4.26 5.44v6.3zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zm1.78 13.02H3.56V9h3.56v11.45zM22.23 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.46c.98 0 1.77-.77 1.77-1.72V1.72C24 .77 23.21 0 22.23 0z"/>
            </svg>
            LinkedIn
          </a>

          <a href="/cv.pdf" download class="btn-ghost">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
              <polyline points="7 10 12 15 17 10"/>
              <line x1="12" y1="15" x2="12" y2="3"/>
            </svg>
            Resume
          </a>
        </div>

      </div>
    </div>

    <!-- Scroll cue -->
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 hidden md:flex flex-col items-center gap-2 animate-bounce opacity-30">
      <span class="font-mono text-[10px] tracking-widest text-text-dim uppercase">Scroll</span>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-text-dim">
        <polyline points="6 9 12 15 18 9"/>
      </svg>
    </div>

  </div>
</section>
