---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Ismail Triki | Cloud Engineer, DevOps & DevSecOps',
  description = 'Cloud Engineering graduate based in Marburg, Germany, building cloud-native infrastructure with Kubernetes, Terraform, Ansible, CI/CD, Linux, and DevSecOps automation.',
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(`${base}/profile.png`, Astro.site);

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Ismail Triki',
  jobTitle: 'Cloud Engineer',
  description: 'Cloud Engineering graduate specializing in Kubernetes, Infrastructure as Code, CI/CD automation, and DevSecOps.',
  url: 'https://iiismailtriki.github.io/ismail-portfolio/',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Marburg',
    addressCountry: 'DE',
  },
  sameAs: [
    'https://github.com/iiismailtriki',
    'https://www.linkedin.com/in/ismail-triki-3571a21a7/',
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="Ismail Triki" />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    <script async src="https://plausible.io/js/pa-qLuRoeAfpOlEclWWWvJYC.js"></script>
    <script>
      window.plausible=window.plausible||function(){(plausible.q=plausible.q||[]).push(arguments)},plausible.init=plausible.init||function(i){plausible.o=i||{}};
      plausible.init()
    </script>
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to content</a>
    <slot />
    <script>
      import { trackEvent } from '../utils/plausible';

      document.addEventListener('click', (e) => {
        const el = (e.target as Element).closest('[data-track]');
        if (!el) return;
        const name = el.getAttribute('data-track');
        if (name) trackEvent(name);
      });
    </script>

    <script>
      // Scroll animation observer
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('visible');
            }
          });
        },
        { threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
      );

      document.querySelectorAll('.animate-on-scroll').forEach((el) => {
        observer.observe(el);
      });
    </script>
  </body>
</html>
