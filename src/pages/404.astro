---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import '../styles/global.css';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base
  title="Page Not Found | Ismail Triki"
  description="This page doesn't exist. Return to Ismail Triki's Cloud & DevOps engineering portfolio."
>
  <Nav />
  <main id="main-content" class="min-h-screen flex items-center justify-center px-6 pt-24">
    <div class="text-center max-w-md">
      <p class="font-mono text-sm text-accent-cyan tracking-widest uppercase mb-4">404</p>
      <h1 class="font-display text-3xl md:text-4xl text-text-primary mb-4">Page not found</h1>
      <p class="text-text-muted mb-8 leading-relaxed">
        The page you're looking for doesn't exist or may have moved.
      </p>
      <a href={base || '/'} class="btn-primary">
        Back to homepage
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <line x1="5" y1="12" x2="19" y2="12"/>
          <polyline points="12 5 19 12 12 19"/>
        </svg>
      </a>
    </div>
  </main>
</Base>
