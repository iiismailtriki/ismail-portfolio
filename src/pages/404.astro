---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { caseStudies } from '../data/site';
import { withBase } from '../utils/paths';
---

<Base title="Page not found | Ismail Triki" description="This page doesn't exist." noindex>
  <main id="main-content" class="container-page flex min-h-[80vh] items-center pt-24 pb-16">
    <div class="max-w-xl">
      <p class="font-mono text-sm text-accent-cyan">HTTP 404</p>
      <h1 class="mt-3 font-display text-4xl text-text-primary md:text-5xl">Page not found</h1>
      <p class="mt-4 leading-relaxed text-text-muted">
        The page you're looking for doesn't exist or has moved. These might be what you were after:
      </p>
      <ul class="mt-6 space-y-2">
        {
          caseStudies.map((c) => (
            <li>
              <a href={c.href} class="link-arrow text-sm">
                {c.title} <Icon name="arrow-right" size={13} />
              </a>
            </li>
          ))
        }
      </ul>
      <a href={withBase('/')} class="btn-primary mt-8">
        <Icon name="arrow-left" size={15} /> Back to homepage
      </a>
    </div>
  </main>
</Base>
